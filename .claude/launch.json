{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "${workspaceFolder}/backend/.venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--port", "8000", "--host", "127.0.0.1"],
      "port": 8000
    },
    {
      "name": "frontend",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "/opt/homebrew/opt/node@20/bin/npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    }
  ]
}
