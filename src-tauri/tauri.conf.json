{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DB-care",
  "version": "2.1.10",
  "identifier": "com.dbcare.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:8765",
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "DB-care",
    "category": "Productivity",
    "shortDescription": "당뇨 합병증 예측",
    "longDescription": "병원 내부용 당뇨 합병증 예측 프로그램. 6개 ML 알고리즘으로 환자의 합병증 위험도를 예측하고 시뮬레이션 합니다.",
    "copyright": "© 2026 DB-care. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "externalBin": [],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "displayLanguageSelector": false
      }
    }
  }
}
